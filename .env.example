# Copia local. Node no carga este archivo solo.
# No subas .env ni credenciales reales.

NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
LOG_LEVEL=info

# Un solo origen del navegador. Vacío desactiva CORS. No uses *.
# En local puede quedar vacío: Vite reenvía /health y /api.
CORS_ORIGIN=

# URL de ejemplo. Sustituye USER y PASSWORD en local.
# db:migrate solo acepta dos destinos de desarrollo:
# - base field_service_dev en 127.0.0.1 o localhost
# - base appweb_ykvs en su host de Render ya identificado
# Cualquier otro nombre o host se rechaza. La API no migra al arrancar.
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/field_service_dev

# URL absoluta de la API. Vacía en desarrollo y en el servicio único:
# el navegador llama a /health y /api en el mismo origen.
# Un build de producción rechaza http://127.0.0.1 y http://localhost.
VITE_API_URL=
